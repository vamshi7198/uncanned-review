# Single entry point: /api/* goes to FastAPI, everything else to Next.js.
#
# SITE_ADDRESS ":80" serves plain HTTP (local use). Set it to a domain name,
# e.g. "review.example.com", and Caddy obtains and renews a free Let's Encrypt
# certificate automatically. See README "HTTPS".
{
	admin off
	servers {
		# Requests arrive from a local proxy (Docker gateway / Cloudflare
		# Tunnel). Trust it, and take the visitor's real IP from Cloudflare's
		# header so per-address sign-in limits apply per visitor.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS::80} {
	# The app's old address; keep links working.
	@old_address host review.uncanned.in
	redir @old_address https://cutroom.uncanned.in{uri} permanent

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle /api/* {
		# Uploads arrive in chunks (8 MB by default), so a small cap is enough.
		request_body {
			max_size 64MB
		}
		reverse_proxy backend:8000 {
			# Pass exactly one, trusted client address to the backend.
			header_up X-Forwarded-For {client_ip}
			# Stream video and upload responses without buffering.
			flush_interval -1
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
