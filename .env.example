# Copy to .env (or run scripts/init-env.sh / scripts/init-env.ps1, which
# generates the secrets for you). Never commit .env.

# --- Required -------------------------------------------------------------
# Database password. Any long random string.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# One-time token for the first-run administrator page (/setup). It only works
# while no accounts exist. Leave empty to disable web setup and use the CLI.
BOOTSTRAP_TOKEN=change-me-to-another-long-random-string

# --- Access ---------------------------------------------------------------
# Port on this machine. Open http://localhost:8090
HTTP_PORT=8090
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from your network
# (e.g. so the editor can use it over the office Wi-Fi or a VPN).
HTTP_BIND=127.0.0.1

# ":80" for plain HTTP. For HTTPS on a server, set your domain here and use
# docker-compose.prod.yml (see README).
SITE_ADDRESS=:80
# Must be true whenever the site is served over HTTPS.
COOKIE_SECURE=false

# --- Branding -------------------------------------------------------------
APP_NAME=Uncanned Review

# --- Storage --------------------------------------------------------------
# Largest video accepted, in bytes (default 10 GiB).
MAX_UPLOAD_BYTES=10737418240
# Leave unset to keep videos in the Docker volume "uncanned-review_media".
# Or set an absolute path, e.g. D:/uncanned-review-media, to use another drive.
# MEDIA_DIR=
